---
import { getCollection } from 'astro:content';
import { u } from '../lib/site';
import { publishedNotes } from '../lib/notes';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const notes = (await publishedNotes()).slice(0, 6);
const commands = [
  ...work.map((w) => ({ label: `Open ${w.data.title}`, hint: `EXP-${w.data.code}`, href: u(`/work/${w.id}/`) })),
  { label: 'Go to the specimen bench', hint: 'work', href: u('/#work') },
  { label: 'Go to lab notes', hint: 'blog', href: u('/notes/') },
  ...notes.map((n) => ({ label: `Read “${n.data.title}”`, hint: 'note', href: u(`/notes/${n.id}/`) })),
  { label: 'Go to about', hint: 'me', href: u('/about/') },
  { label: 'Copy email address', hint: 'contact', action: 'copy-email' },
  { label: 'Copy RSS feed URL', hint: 'subscribe', action: 'copy-feed', value: new URL(u('/rss.xml'), Astro.site).href },
  { label: 'Unleash chaos', hint: 'easter egg', action: 'chaos' },
];
---
<dialog class="palette" id="palette" aria-label="Jump to">
  <input id="palette-input" type="text" placeholder="Type a project, a page or “chaos”…" autocomplete="off" role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list" />
  <ul id="palette-list" role="listbox" aria-label="Results"></ul>
  <p class="mono hint">↑↓ to move · Enter to open · Esc to close</p>
  <script type="application/json" id="palette-data" set:html={JSON.stringify(commands)} />
</dialog>
<style>
  dialog.palette { border: 1.5px solid var(--ink); border-radius: 14px; padding: 0; width: min(560px, calc(100vw - 32px)); background: var(--paper); color: var(--ink); box-shadow: 0 30px 60px -30px var(--shadow); margin-top: 12vh; }
  dialog.palette::backdrop { background: rgba(10, 14, 30, .35); }
  input { width: 100%; border: 0; border-bottom: 1.5px solid var(--ink); padding: 16px 18px; font: inherit; font-size: 1.1rem; background: transparent; color: inherit; outline: none; }
  ul { list-style: none; margin: 0; padding: 6px; max-height: 360px; overflow: auto; }
  :global(.palette li) { padding: 10px 12px; border-radius: 8px; display: flex; justify-content: space-between; gap: 12px; cursor: pointer; }
  :global(.palette li[aria-selected="true"]) { background: var(--ink); color: var(--paper); }
  :global(.palette li .k) { opacity: .7; font-family: var(--font-mono); font-size: .8rem; white-space: nowrap; }
  .hint { color: var(--ink-soft); padding: 8px 16px 12px; border-top: 1px solid var(--grid-strong); }
</style>
