---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; wide?: boolean }
const { src, alt, caption, wide = true } = Astro.props;
---
<figure class:list={['fig', wide && 'wide']}>
  <Image src={src} alt={alt} widths={[640, 1100, 1440]} sizes="(max-width: 900px) 100vw, 1100px" />
  {caption && <figcaption class="mono">{caption}</figcaption>}
</figure>
<style>
  .fig { margin: 1.4em 0 0; }
  .fig :global(img) { display: block; width: 100%; height: auto; border: 1.5px solid var(--ink); border-radius: 10px; background: var(--paper-card); }
  figcaption { color: var(--ink-soft); margin-top: 8px; }
</style>
